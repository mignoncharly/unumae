# Copy to .env and fill in. Never commit .env — see .gitignore.
#
# Local development uses the disposable Supabase CLI stack. The single hosted
# project's values live only in the protected production EAS/GitHub environment
# (docs/ENVIRONMENTS.md).
APP_ENV=development
#
# The anon/publishable key is public by design — it is safe in the client only
# because Row Level Security is enabled on every table (docs/SECURITY.md).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=local-publishable-key-from-supabase-status
# Public numeric Google Cloud project identifier used to prepare Play Integrity.
EXPO_PUBLIC_GOOGLE_CLOUD_PROJECT_NUMBER=123456789012
