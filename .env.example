# Copy to .env and fill in. Never commit .env — see .gitignore.
#
# One Supabase project for the whole lifecycle (docs/ENVIRONMENTS.md). There is
# deliberately no APP_ENV: nothing here switches between databases.
#
# The anon/publishable key is public by design — it is safe in the client only
# because Row Level Security is enabled on every table (docs/SECURITY.md).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
