# Copy to .env and fill in. Never commit .env — see .gitignore.
#
# Three environments, three Supabase projects (docs/ARCHITECTURE.md).
# APP_ENV selects the app name, bundle identifier and deep-link scheme.
#   development | staging | production
APP_ENV=development

# Supabase — the anon key is public by design; it is safe in the client only
# because Row Level Security is enabled on every table (docs/SECURITY.md).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
