#!/bin/sh
#
# Fast local feedback before GitHub's required CI jobs run. This hook is a
# convenience, not the release security boundary: it can be bypassed locally.
#
# Installed by `npm install` (the prepare script sets core.hooksPath).
# Emergency bypass, to be used almost never: git push --no-verify
#
set -e

echo "pre-push: npm run verify"
npm run verify

echo "pre-push: OK"
