{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "production",
      "env": { "APP_ENV": "hosted" },
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    "development-simulator": {
      "environment": "production",
      "env": { "APP_ENV": "hosted" },
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "e2e-test": {
      "environment": "production",
      "env": { "APP_ENV": "hosted" },
      "withoutCredentials": true,
      "ios": { "simulator": true },
      "android": { "buildType": "apk" }
    },
    "production": {
      "environment": "production",
      "env": { "APP_ENV": "production" },
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6804251671",
        "appleId": "charles.nguenkam@gmail.com",
        "appleTeamId": "UB67843RJK",
        "language": "en-US"
      }
    }
  }
}
