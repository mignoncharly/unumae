{
  "name": "unumae",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:staging": "cross-env APP_ENV=staging expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run verify:migrations && npm run test",
    "prepare": "git config core.hooksPath .githooks",
    "db:push": "node scripts/db.mjs push",
    "db:list": "node scripts/db.mjs list",
    "db:types": "node scripts/db.mjs types",
    "verify:draw": "node scripts/verify-draw.mjs",
    "verify:privileges": "node scripts/verify-privileges.mjs",
    "verify:live": "npm run verify:draw && npm run verify:privileges && npm run verify:security",
    "web:dev": "npm --prefix website run dev",
    "web:build": "npm --prefix website run build",
    "web:check": "npm --prefix website run verify",
    "web:quality": "npm --prefix website run quality",
    "verify:security": "node scripts/verify-security.mjs",
    "simulate": "node scripts/simulate-cycle.mjs",
    "db:settings": "node scripts/db-settings.mjs",
    "dev:code": "node scripts/dev-code.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/query-async-storage-persister": "^5.102.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.102.0",
    "expo": "^57.0.15",
    "expo-apple-authentication": "~57.0.1",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.12",
    "expo-image-picker": "~57.0.12",
    "expo-linking": "~57.0.7",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.13",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "i18next": "^26.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^17.0.12",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.18",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "prettier": "^3.9.6",
    "test-renderer": "^1.2.0",
    "typescript": "^6.0.3"
  }
}
