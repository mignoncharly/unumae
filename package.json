{
  "name": "unumae",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:hosted": "cross-env APP_ENV=hosted expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:db:phase1": "supabase test db supabase/tests/phase1_account_enforcement.sql",
    "test:db:phase2": "supabase test db supabase/tests/phase2_retryable_account_deletion.sql",
    "test:db:phase3": "supabase test db supabase/tests/phase3_database_contract.sql",
    "test:db:phase4": "supabase test db supabase/tests/phase4_account_assurance.sql",
    "test:db:phase5": "supabase test db supabase/tests/phase5_privacy_export.sql",
    "test:db:phase6": "supabase test db supabase/tests/phase6_abuse_data_integrity.sql",
    "test:db:phase7": "supabase test db supabase/tests/phase7_worker_notification_reliability.sql",
    "test:db:phase8": "supabase test db supabase/tests/phase8_mobile_correctness.sql",
    "test:edge": "deno test --config supabase/functions/deno.json --allow-env supabase/functions/_shared/*.test.ts",
    "verify:edge": "node scripts/verify-edge-functions.mjs",
    "db:types:local": "node scripts/generate-db-types.mjs --write",
    "verify:db-types": "node scripts/generate-db-types.mjs",
    "test:watch": "jest --watch",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run verify:migrations && npm run verify:operations && npm run test",
    "prepare": "git config core.hooksPath .githooks",
    "db:push": "node scripts/db.mjs push",
    "db:list": "node scripts/db.mjs list",
    "db:types": "node scripts/db.mjs types",
    "verify:draw": "node scripts/verify-draw.mjs",
    "verify:privileges": "node scripts/verify-privileges.mjs",
    "verify:integration": "npm run verify:draw && npm run verify:privileges && npm run verify:security",
    "verify:live": "node scripts/verify-draw.mjs --live && node scripts/verify-privileges.mjs --live && node scripts/verify-security.mjs --live",
    "web:dev": "npm --prefix website run dev",
    "web:build": "npm --prefix website run build",
    "web:check": "npm --prefix website run verify",
    "web:quality": "npm --prefix website run quality",
    "verify:security": "node scripts/verify-security.mjs",
    "verify:safety": "node scripts/verify-safety-privacy.mjs",
    "verify:safety:live": "node scripts/verify-safety-privacy.mjs --live",
    "verify:memory": "node scripts/verify-memory-international.mjs",
    "verify:memory:live": "node scripts/verify-memory-international.mjs --live",
    "verify:delete-account:live": "node scripts/verify-delete-account.mjs --live",
    "verify:release-config": "node scripts/verify-release-config.mjs",
    "verify:operations": "node scripts/verify-operational-readiness.mjs",
    "verify:hosted": "node scripts/verify-hosted-phase-c.mjs",
    "baseline:production": "node scripts/capture-production-baseline.mjs",
    "e2e:ios": "node scripts/run-ios-e2e.mjs",
    "e2e:ios:eas": "eas workflow:run .eas/workflows/e2e-ios.yml",
    "e2e:android:eas": "eas workflow:run .eas/workflows/e2e-android.yml",
    "simulate": "node scripts/simulate-cycle.mjs",
    "simulate:live": "node scripts/simulate-cycle.mjs --live",
    "db:settings": "node scripts/db-settings.mjs",
    "dev:code": "node scripts/dev-code.mjs"
  },
  "dependencies": {
    "@expo/app-integrity": "^57.0.1",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/query-async-storage-persister": "^5.102.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.102.0",
    "expo": "~57.0.19",
    "expo-apple-authentication": "~57.0.1",
    "expo-constants": "~57.0.15",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-manipulator": "~57.0.15",
    "expo-image-picker": "~57.0.15",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.16",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "i18next": "^26.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^17.0.12",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.18",
    "cross-env": "^10.1.0",
    "deno": "2.1.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "test-renderer": "^1.2.0",
    "typescript": "^6.0.3"
  }
}
