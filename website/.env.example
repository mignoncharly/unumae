# Absolute public origin used for canonical URLs, sitemap, and robots.txt.
# Keep localhost for development; set the real origin only after DNS is ready.
SITE_ORIGIN=http://localhost:4321

# Public Today and Archive remain request-free until explicitly enabled.
PUBLIC_DATA_MODE=off

# Required only when PUBLIC_DATA_MODE=live. Use the public project URL and anon
# key. Never place a Supabase service-role key in a PUBLIC_ variable.
# Live release builds also use this reader to generate no-JavaScript Human
# snapshots and person-specific social cards from already published records.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Optional same-origin path that accepts the three allowlisted, anonymous
# marketing funnel events. Leave empty to ship no marketing measurement.
PUBLIC_ANALYTICS_ENDPOINT=
