---
import PublicState from './ui/PublicState.astro';
import { publicContent } from '../content/public';
import type { Locale } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { createHumanMetadata } from '../lib/metadata';
import type { HumanSnapshot } from '../lib/human-snapshots';

interface Props {
  locale: Locale;
  snapshot?: HumanSnapshot;
}

const { locale, snapshot } = Astro.props;
const copy = publicContent[locale];
const dataMode = import.meta.env.PUBLIC_DATA_MODE === 'live' ? 'live' : 'off';
const supabaseUrl =
  dataMode === 'live' ? (import.meta.env.PUBLIC_SUPABASE_URL ?? '') : '';
const supabaseAnonKey =
  dataMode === 'live' ? (import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '') : '';

if (dataMode === 'live' && (!supabaseUrl || !supabaseAnonKey)) {
  throw new Error(
    'PUBLIC_DATA_MODE=live requires PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY.'
  );
}

const site =
  Astro.site ?? new URL(import.meta.env.SITE_ORIGIN ?? 'http://localhost:4321');
const pageMetadata = snapshot
  ? createHumanMetadata(locale, snapshot.human, site)
  : undefined;
const humanNumber = snapshot?.human.human_number
  ? `#${String(snapshot.human.human_number).padStart(4, '0')}`
  : '—';
const humanDate = snapshot
  ? new Intl.DateTimeFormat(locale, {
      dateStyle: 'long',
      timeZone: 'UTC',
    }).format(new Date(`${snapshot.human.selection_date}T00:00:00Z`))
  : '';
const regionNames = new Intl.DisplayNames([locale], { type: 'region' });
const humanLocation = snapshot
  ? [
      snapshot.human.city,
      snapshot.human.country_code
        ? regionNames.of(snapshot.human.country_code)
        : null,
    ]
      .filter(Boolean)
      .join(' · ')
  : '';
---

<BaseLayout
  locale={locale}
  page="archive"
  title={`${copy.archive.hero.title} · Unumae`}
  description={copy.archive.hero.introduction}
  omitCanonicalLinks={!snapshot}
  pageMetadata={pageMetadata}
>
  <main
    id="main-content"
    tabindex="-1"
    class="public-main human-public-page"
    data-public-human
    data-data-mode={dataMode}
    data-has-snapshot={snapshot ? 'true' : 'false'}
    data-supabase-url={supabaseUrl}
    data-supabase-anon-key={supabaseAnonKey}
  >
    <header class="public-hero">
      <p class="eyebrow">{copy.archive.hero.eyebrow}</p>
      <h1>{snapshot?.human.display_name ?? copy.archive.hero.title}</h1>
      <p class="introduction">
        {pageMetadata?.description ?? copy.archive.hero.introduction}
      </p>
    </header>

    <div class="public-stage">
      <PublicState
        state="launch"
        content={copy.archive.launch}
        hidden={dataMode === 'live' || Boolean(snapshot)}
      />
      <PublicState
        state="loading"
        content={copy.archive.loading}
        hidden={dataMode !== 'live' || Boolean(snapshot)}
      />
      <PublicState state="not-found" content={copy.archive.noMatch} />
      <PublicState state="error" content={copy.archive.error}>
        <button class="public-button" type="button" data-retry>
          {copy.archive.error.retry}
        </button>
      </PublicState>

      <article
        class="today-human"
        data-state="live"
        hidden={!snapshot}
        aria-live="polite"
      >
        <header class="today-human__header">
          <div>
            <p class="eyebrow">{copy.archive.hero.eyebrow}</p>
            <p class="today-human__number">
              <span>{copy.today.live.humanLabel}</span>
              <strong data-human-number>{humanNumber}</strong>
            </p>
          </div>
          <p data-human-date>{humanDate}</p>
        </header>

        <div class="today-human__identity">
          <div class="today-human__media">
            <img
              data-human-photo
              hidden
              src="/icons/icon-32.png"
              width="640"
              height="800"
              decoding="async"
              alt=""
            />
            <div class="public-photo-placeholder" data-photo-placeholder>
              <img
                src="/editorial/today-empty-chair.webp"
                width="960"
                height="1200"
                loading="lazy"
                decoding="async"
                alt=""
                aria-hidden="true"
              />
              <span class="editorial-fallback-label">
                {copy.archive.entry.editorialFallback}
              </span>
            </div>
          </div>
          <div class="today-human__nameplate">
            <h2 data-human-name>
              {snapshot?.human.display_name ?? copy.archive.hero.title}
            </h2>
            <p data-human-location>{humanLocation}</p>
            <p
              class="today-human__founding"
              data-human-founding
              hidden={snapshot?.human.founding !== true}
            >
              {copy.today.live.foundingLabel}
            </p>
          </div>
        </div>

        <button
          class="public-button public-translation-toggle"
          type="button"
          data-translation-toggle
          hidden
        >
          {copy.today.live.showTranslated}
        </button>

        <section class="today-portrait" aria-labelledby="human-portrait-title">
          <p class="eyebrow">01</p>
          <h2 id="human-portrait-title">{copy.today.live.portraitLabel}</h2>
          <dl data-portrait-list>
            {
              snapshot?.portrait.map((element) => (
                <div>
                  <dt>{copy.today.live.prompts[element.element_key]}</dt>
                  <dd>{element.answer}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section
          class="today-questions"
          aria-labelledby="human-questions-title"
        >
          <p class="eyebrow">02</p>
          <h2 id="human-questions-title">{copy.today.live.questionsTitle}</h2>
          <ol data-question-list>
            {
              snapshot?.questions.map((question) => (
                <li>
                  <p class="public-question__body">{question.body}</p>
                  <p
                    class:list={[
                      'public-question__answer',
                      {
                        'public-question__answer--pending': !question.answer,
                      },
                    ]}
                  >
                    {question.answer ?? copy.today.live.unanswered}
                  </p>
                </li>
              ))
            }
          </ol>
          <p data-no-questions hidden={(snapshot?.questions.length ?? 0) > 0}>
            {copy.today.live.noQuestions}
          </p>
        </section>

        <p class="today-human__guest-note">{copy.today.live.guestNote}</p>
      </article>
    </div>
  </main>
  <script>
    import '../scripts/human-page.ts';
  </script>
</BaseLayout>
