---
import ActionLink from './ui/ActionLink.astro';
import PublicState from './ui/PublicState.astro';
import { publicContent, type PublicPageKey } from '../content/public';
import { localizedPath, type Locale } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
  page: PublicPageKey;
}

const { locale, page } = Astro.props;
const copy = publicContent[locale];
const dataMode = import.meta.env.PUBLIC_DATA_MODE === 'live' ? 'live' : 'off';
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---

<BaseLayout locale={locale} page={page}>
  <main
    id="main-content"
    class:list={['public-main', `${page}-public-page`]}
    data-public-page={page}
    data-data-mode={dataMode}
    data-supabase-url={supabaseUrl}
    data-supabase-anon-key={supabaseAnonKey}
  >
    <header class="public-hero">
      <p class="eyebrow">{copy[page].hero.eyebrow}</p>
      <h1>{copy[page].hero.title}</h1>
      <p class="introduction">{copy[page].hero.introduction}</p>
    </header>

    {
      page === 'today' && (
        <div class="public-stage">
          <PublicState
            state="launch"
            content={copy.today.launch}
            hidden={dataMode === 'live'}
          />
          <PublicState
            state="loading"
            content={copy.today.loading}
            hidden={dataMode !== 'live'}
          />
          <PublicState state="quiet" content={copy.today.quiet}>
            <ActionLink
              href={localizedPath(locale, 'archive')}
              variant="secondary"
            >
              {copy.today.quiet.archiveLink}
            </ActionLink>
          </PublicState>
          <PublicState state="error" content={copy.today.error}>
            <button class="public-button" type="button" data-retry>
              {copy.today.error.retry}
            </button>
          </PublicState>

          <article
            class="today-human"
            data-state="live"
            hidden
            aria-live="polite"
          >
            <header class="today-human__header">
              <div>
                <p class="eyebrow">{copy.today.live.liveLabel}</p>
                <p class="today-human__number">
                  <span>{copy.today.live.humanLabel}</span>
                  <strong data-human-number>—</strong>
                </p>
              </div>
              <div class="today-human__clock">
                <span>{copy.today.live.remainingLabel}</span>
                <time data-countdown datetime="PT24H">
                  24:00:00
                </time>
              </div>
            </header>

            <div class="today-human__identity">
              <div class="today-human__media">
                <img
                  data-today-photo
                  hidden
                  width="640"
                  height="800"
                  decoding="async"
                  fetchpriority="high"
                  alt=""
                />
                <div class="public-photo-placeholder" data-photo-placeholder>
                  <span aria-hidden="true">U</span>
                </div>
              </div>
              <div class="today-human__nameplate">
                <p data-human-date />
                <h2 data-human-name />
                <p data-human-location />
                {/* Hidden until the reader says so. A historical note, not a rank. */}
                <p class="today-human__founding" data-human-founding hidden />
              </div>
            </div>

            <section class="today-portrait" aria-labelledby="portrait-title">
              <p class="eyebrow">01</p>
              <h2 id="portrait-title">{copy.today.live.portraitLabel}</h2>
              <dl data-portrait-list />
            </section>

            <section class="today-questions" aria-labelledby="questions-title">
              <p class="eyebrow">02</p>
              <h2 id="questions-title">{copy.today.live.questionsTitle}</h2>
              <ol data-question-list />
              <p data-no-questions hidden>
                {copy.today.live.noQuestions}
              </p>
            </section>

            <p class="today-human__guest-note">{copy.today.live.guestNote}</p>
          </article>
        </div>
      )
    }

    {
      page === 'archive' && (
        <>
          <ol class="archive-principles">
            {copy.archive.principles.map((principle, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h2>{principle.title}</h2>
                <p>{principle.body}</p>
              </li>
            ))}
          </ol>

          <div class="archive-stage">
            <PublicState
              state="launch"
              content={copy.archive.launch}
              hidden={dataMode === 'live'}
            />
            <PublicState
              state="loading"
              content={copy.archive.loading}
              hidden={dataMode !== 'live'}
            />
            <PublicState state="empty" content={copy.archive.empty} />
            <PublicState state="no-match" content={copy.archive.noMatch} />
            <PublicState state="error" content={copy.archive.error}>
              <button class="public-button" type="button" data-retry>
                {copy.archive.error.retry}
              </button>
            </PublicState>

            <div class="archive-explorer" data-archive-explorer hidden>
              <div class="archive-controls">
                <div class="archive-controls__heading">
                  <p class="eyebrow">{copy.archive.controls.label}</p>
                  <p>{copy.archive.controls.chronological}</p>
                </div>
                <label>
                  <span>{copy.archive.controls.country}</span>
                  <select data-country-filter>
                    <option value="">{copy.archive.controls.everywhere}</option>
                  </select>
                </label>
                <label>
                  <span>{copy.archive.controls.year}</span>
                  <select data-year-filter>
                    <option value="">{copy.archive.controls.allYears}</option>
                  </select>
                </label>
                <button class="public-button" type="button" data-random>
                  {copy.archive.controls.random}
                </button>
              </div>

              <aside class="archive-random" data-random-result hidden />

              <section data-state="ready" hidden aria-live="polite">
                <ol class="archive-grid" data-archive-list />
                <div class="archive-pagination">
                  <button class="public-button" type="button" data-load-more>
                    {copy.archive.controls.loadMore}
                  </button>
                  <p data-archive-end hidden>
                    {copy.archive.controls.end}
                  </p>
                </div>
              </section>
            </div>
          </div>
        </>
      )
    }
  </main>
  <script>
    import '../scripts/public-pages.ts';
  </script>
</BaseLayout>
