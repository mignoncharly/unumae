---
import ActionLink from './ui/ActionLink.astro';
import { legalLastUpdated, sectionsFor } from '../content/legal';
import {
  content,
  localizedPath,
  type Locale,
  type PageKey,
  type RouteKey,
} from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
  page: RouteKey;
}

const { locale, page } = Astro.props;
const copy = content[locale];
const pageCopy = copy.pages[page];
const isHome = page === 'home';

// Privacy, terms and the community guidelines carry long-form text; every
// other route is intro-only.
const sections = isHome ? [] : sectionsFor(locale, page as PageKey);
---

<BaseLayout locale={locale} page={page}>
  <main
    id="main-content"
    tabindex="-1"
    class:list={['page-main', { 'page-main--home': isHome }]}
  >
    <section class="page-intro" aria-labelledby="page-title">
      <p class="eyebrow">{pageCopy.eyebrow}</p>
      <h1 id="page-title">{pageCopy.title}</h1>
      <p class="introduction">{pageCopy.introduction}</p>

      {
        isHome && (
          <div class="actions">
            <ActionLink
              href={localizedPath(locale, 'how-selection-works')}
              analyticsEvent="selection_explainer_opened"
            >
              {copy.navigation['how-selection-works']}
            </ActionLink>
            <span class="launch-state">{copy.comingSoon}</span>
          </div>
        )
      }
    </section>

    {
      isHome && (
        <dl class="facts">
          {copy.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      pageCopy.notice && (
        <aside class="notice" aria-label={pageCopy.eyebrow}>
          <p>{pageCopy.notice}</p>
        </aside>
      )
    }

    {
      sections.length > 0 && (
        <div class="legal-body">
          {sections.map((section) => (
            <section class="legal-section">
              <h2>{section.title}</h2>
              <p>{section.body}</p>
            </section>
          ))}

          <p class="legal-updated">
            {copy.lastUpdated.replace('{date}', legalLastUpdated)}
          </p>
        </div>
      )
    }
  </main>
</BaseLayout>

<style>
  /* Long-form text, measured for reading rather than for filling the page. */
  .legal-body {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    max-width: 38rem;
  }

  .legal-section h2 {
    font-size: 1.125rem;
    margin: 0 0 0.5rem;
  }

  .legal-section p {
    margin: 0;
    line-height: 1.65;
  }

  .legal-updated {
    margin: 0;
    font-size: 0.875rem;
    opacity: 0.7;
  }
</style>
