---
interface Props {
  label?: string;
  detail?: string;
}

const {
  label = 'Campaign study',
  detail = 'Abstract composition · no Human shown',
} = Astro.props;
---

<figure class="campaign-study">
  <div class="campaign-study__crop" aria-hidden="true">
    <span class="campaign-study__sun"></span>
    <span class="campaign-study__horizon"></span>
    <span class="campaign-study__figure"></span>
    <span class="campaign-study__grain"></span>
  </div>
  <figcaption>
    <span>{label}</span>
    <span>{detail}</span>
  </figcaption>
</figure>
