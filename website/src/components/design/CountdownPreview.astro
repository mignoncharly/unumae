---
const groups = [
  ['1', '8'],
  ['4', '3'],
  ['1', '2'],
] as const;
---

<time
  class="countdown"
  datetime="PT18H43M12S"
  aria-label="18 hours, 43 minutes, 12 seconds remaining"
>
  <span class="sr-only">18:43:12 remaining</span>
  <span class="countdown__visual" aria-hidden="true">
    {
      groups.map((group, groupIndex) => (
        <>
          <span class="countdown__group">
            {group.map((digit, digitIndex) => (
              <span
                class="countdown__digit"
                style={`--digit-index: ${groupIndex * 2 + digitIndex}`}
              >
                {digit}
              </span>
            ))}
          </span>
          {groupIndex < groups.length - 1 && (
            <span class="countdown__separator">:</span>
          )}
        </>
      ))
    }
  </span>
</time>
