---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { content, type Locale, type RouteKey } from '../content/site';
import { normalizeAnalyticsEndpoint } from '../lib/analytics';
import { createPageMetadata } from '../lib/metadata';
import '../styles/global.css';

interface Props {
  locale: Locale;
  page: RouteKey;
  title?: string;
  description?: string;
  noIndex?: boolean;
  omitCanonicalLinks?: boolean;
}

const {
  locale,
  page,
  title,
  description,
  noIndex = false,
  omitCanonicalLinks = false,
} = Astro.props;
const copy = content[locale];
const site =
  Astro.site ?? new URL(import.meta.env.SITE_ORIGIN ?? 'http://localhost:4321');
const metadata = createPageMetadata(locale, page, site);
const resolvedTitle = title ?? metadata.title;
const resolvedDescription = description ?? metadata.description;
const englishAlternate = metadata.alternates.find(
  (alternate) => alternate.locale === 'en'
);
const structuredData = JSON.stringify(metadata.structuredData).replace(
  /</g,
  '\\u003c'
);
const isSecureSocialImage = metadata.socialImage.url.startsWith('https://');
const analyticsEndpoint = normalizeAnalyticsEndpoint(
  import.meta.env.PUBLIC_ANALYTICS_ENDPOINT
);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f7f5" />
    <link rel="icon" href="/icons/icon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="preload"
      href="/fonts/inter-variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/newsreader-variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="description" content={resolvedDescription} />
    {
      (noIndex || metadata.noIndex) && (
        <meta name="robots" content="noindex, follow" />
      )
    }
    {!omitCanonicalLinks && <link rel="canonical" href={metadata.canonical} />}
    {
      !omitCanonicalLinks &&
        metadata.alternates.map((alternate) => (
          <link
            rel="alternate"
            hreflang={alternate.locale}
            href={alternate.href}
          />
        ))
    }
    {
      !omitCanonicalLinks && englishAlternate && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={englishAlternate.href}
        />
      )
    }
    {
      !omitCanonicalLinks && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="Unumae" />
          <meta property="og:title" content={resolvedTitle} />
          <meta property="og:description" content={resolvedDescription} />
          <meta property="og:url" content={metadata.canonical} />
          <meta property="og:locale" content={metadata.openGraphLocale} />
          {metadata.openGraphLocaleAlternates.map((alternate) => (
            <meta property="og:locale:alternate" content={alternate} />
          ))}
          <meta property="og:image" content={metadata.socialImage.url} />
          {isSecureSocialImage && (
            <meta
              property="og:image:secure_url"
              content={metadata.socialImage.url}
            />
          )}
          <meta property="og:image:type" content={metadata.socialImage.type} />
          <meta
            property="og:image:width"
            content={String(metadata.socialImage.width)}
          />
          <meta
            property="og:image:height"
            content={String(metadata.socialImage.height)}
          />
          <meta property="og:image:alt" content={metadata.socialImage.alt} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={resolvedTitle} />
          <meta name="twitter:description" content={resolvedDescription} />
          <meta name="twitter:image" content={metadata.socialImage.url} />
          <meta name="twitter:image:alt" content={metadata.socialImage.alt} />
          <script
            is:inline
            type="application/ld+json"
            set:html={structuredData}
          />
        </>
      )
    }
    <title>{resolvedTitle}</title>
  </head>
  <body data-route={page} data-analytics-endpoint={analyticsEndpoint}>
    <a class="skip-link" href="#main-content">{copy.skipToContent}</a>
    <div class="site-frame">
      <SiteHeader locale={locale} page={page} />
      <slot />
      <SiteFooter locale={locale} />
    </div>
    {analyticsEndpoint && <script>import '../scripts/analytics.ts';</script>}
  </body>
</html>
