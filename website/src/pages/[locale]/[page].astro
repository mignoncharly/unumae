---
import RoutePage from '../../components/RoutePage.astro';
import TrustPage from '../../components/TrustPage.astro';
import { trustPageKeys, type TrustPageKey } from '../../content/trust';
import {
  pageKeys,
  translatedLocales,
  type Locale,
  type PageKey,
} from '../../content/site';

export function getStaticPaths() {
  return translatedLocales.flatMap((locale) =>
    pageKeys.map((page) => ({
      params: { locale, page },
      props: { locale, page },
    }))
  );
}

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props as Props;
const isTrustPage = trustPageKeys.includes(page as TrustPageKey);
---

{
  isTrustPage ? (
    <TrustPage locale={locale} page={page as TrustPageKey} />
  ) : (
    <RoutePage locale={locale} page={page} />
  )
}
