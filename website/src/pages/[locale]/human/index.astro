---
import HumanPage from '../../../components/HumanPage.astro';
import { translatedLocales, type Locale } from '../../../content/site';

export function getStaticPaths() {
  return translatedLocales.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
---

<HumanPage locale={locale} />
