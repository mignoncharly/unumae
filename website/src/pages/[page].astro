---
import RoutePage from '../components/RoutePage.astro';
import TrustPage from '../components/TrustPage.astro';
import { trustPageKeys, type TrustPageKey } from '../content/trust';
import { pageKeys, type PageKey } from '../content/site';

export function getStaticPaths() {
  return pageKeys.map((page) => ({ params: { page }, props: { page } }));
}

interface Props {
  page: PageKey;
}

const { page } = Astro.props as Props;
const isTrustPage = trustPageKeys.includes(page as TrustPageKey);
---

{
  isTrustPage ? (
    <TrustPage locale="en" page={page as TrustPageKey} />
  ) : (
    <RoutePage locale="en" page={page} />
  )
}
